{
  "name": "teamshub",
  "version": "1.0.0",
  "description": "Mac menu bar app for managing multiple Microsoft Teams accounts with Chrome extension",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173/src/settings/index.html && electron .\"",
    "build": "vite build && electron-builder --mac dmg dir",
    "build:ext": "cd extension && zip -r ../TeamsHub-Extension.zip . -x '.*'",
    "package": "npm run build && npm run build:ext",
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-store": "^6.0.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.teamshub.app",
    "productName": "TeamsHub",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "dir"
      ]
    },
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "native-messaging/",
        "to": "native-messaging/",
        "filter": ["**/*"]
      }
    ]
  }
}
